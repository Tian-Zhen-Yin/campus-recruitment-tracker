{
  "manifest_version": 3,
  "name": "秋招一键收录",
  "version": "1.4.6",
  "description": "识别动态招聘岗位网页，并将腾讯招聘文档同步到秋招投递管理器。",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "https://songxue0614-lgtm.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "收录到秋招管理器",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
